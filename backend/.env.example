# "development" (default) | "production". Only gates the startup check
# that refuses to boot with the default SECRET_KEY below -- set this to
# "production" for any real deployment.
ENVIRONMENT=development

# Local SQLite database file (default already points here if unset).
DATABASE_URL=sqlite:///./aletheia.db

# Which AI provider the entity extraction, timeline, risk assessment, and
# report generation services use. Valid values: "mock" | "openai" | "anthropic".
# "mock" (default) uses built-in regex/keyword heuristics and requires no API key.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Never commit a real key.
# OPENAI_API_KEY=
# OpenAI model to use. Must support Structured Outputs (json_schema response
# format). Check https://platform.openai.com/docs/models for a current small/
# cheap model suitable for structured extraction + classification, e.g. a
# gpt-4o-mini-class or gpt-5-mini-class model.
# OPENAI_MODEL=

# Required only when AI_PROVIDER=anthropic. Never commit a real key.
# ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 — the case analysis below is judgment work
# (risk grading, report writing), not plain extraction, so it benefits
# from a stronger model than Haiku.
ANTHROPIC_MODEL=claude-sonnet-5

# Which backend the entity web-search tool (Tools > Entity Search) uses.
# Valid values: "mock" | "openai" | "anthropic" | "tavily".
# "mock" (default) returns a canned result and requires no API key.
# "openai"/"anthropic" reuse the API keys/models above via that provider's
# hosted web-search tool.
SEARCH_PROVIDER=mock

# Required only when SEARCH_PROVIDER=tavily. Never commit a real key.
# TAVILY_API_KEY=

# How long an identical entity search (same query + entity type + provider)
# is served from a previous result instead of re-hitting the search
# provider, in seconds. Set to 0 to disable caching.
SEARCH_CACHE_TTL_SECONDS=3600

# Secret used to sign login tokens (JWTs). MUST be overridden with a long
# random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The default below is fine for local dev only -- the app refuses to start
# with this default value when ENVIRONMENT=production.
SECRET_KEY=dev-only-insecure-secret-change-me-in-production

# Origins allowed to make cross-origin requests to the API, comma-separated.
# Defaults cover the Vite dev server. Set this to your real frontend
# origin(s) in production (e.g. https://app.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long an issued login token stays valid, in hours.
ACCESS_TOKEN_EXPIRE_HOURS=24

# Login brute-force throttling. After LOGIN_RATE_LIMIT_ATTEMPTS failed
# logins for the same account within LOGIN_RATE_LIMIT_WINDOW_SECONDS, that
# account is locked out for LOGIN_RATE_LIMIT_LOCKOUT_SECONDS. A given client
# IP gets a larger allowance (LOGIN_RATE_LIMIT_IP_ATTEMPTS) so it can also
# get locked out if it sprays many different usernames.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300

# Where evidence attachment files (screenshots, PDFs, statements) are
# stored on disk. Defaults under backend/data/ -- point this at a separate
# volume/mount in production.
# EVIDENCE_UPLOAD_DIR=

# Per-file upload size limit, in bytes. Defaults to 20MB.
# EVIDENCE_MAX_ATTACHMENT_SIZE_BYTES=20971520

# Extensions allowed for evidence attachments, comma-separated, no dots.
# Deliberately excludes anything a browser might execute or render inline
# (html, svg, js, ...) -- an attachment is meant to be evidence, not
# interpreted content.
EVIDENCE_ALLOWED_ATTACHMENT_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,csv,eml,docx,xlsx
